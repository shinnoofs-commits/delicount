
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // A user is an admin if their UID exists in the roles_admin collection
      // and their document has the 'role' field set to 'admin'.
      return request.auth != null && get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.role == 'admin';
    }

    function isStoreMember(storeId) {
      return exists(/databases/$(database)/documents/stores/$(storeId)/staff/$(request.auth.uid));
    }

    match /roles_admin/{uid} {
      allow create: if request.auth.uid == uid;
      allow read: if request.auth.uid == uid;
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /stores/{storeId} {
      // Admins can read and write to any store document.
      allow read, write: if isAdmin();

      // Rules for products subcollection
      match /products/{productId} {
        // Admins can manage products. Store members can view them.
        allow read: if isAdmin() || isStoreMember(storeId);
        allow write: if isAdmin();
      }

      // Rules for staff subcollection
      match /staff/{staffId} {
        allow read, write: if isAdmin();
      }
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
