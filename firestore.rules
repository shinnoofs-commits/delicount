rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isStoreOwner(storeId) {
      // Check for existence before accessing data to make the rule more robust.
      return exists(/databases/$(database)/documents/stores/$(storeId)) &&
             get(/databases/$(database)/documents/stores/$(storeId)).data.userId == request.auth.uid;
    }

    match /roles_admin/{uid} {
      allow get: if request.auth.uid == uid || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || request.auth.uid == uid;
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /stores/{storeId} {
      // list: allow any authenticated user (client filters by userId)
      allow list: if request.auth != null;
      // get: must be admin or the store owner
      allow get: if isAdmin() || resource.data.userId == request.auth.uid;
      allow create: if isAdmin() || request.auth.uid == request.resource.data.userId;
      // `update` can use the helper function
      allow update: if isAdmin() || isStoreOwner(storeId);
      allow delete: if isAdmin();

      // Apply consistent rules to all subcollections
      match /products/{productId} {
        allow read, write: if isAdmin() || isStoreOwner(storeId);
      }

      match /price_history/{historyId} {
        allow read, write: if isAdmin() || isStoreOwner(storeId);
      }
      
      match /waste/{wasteId} {
         allow read: if isAdmin() || isStoreOwner(storeId);
         allow create: if isAdmin() || request.auth.uid == request.resource.data.userId;
         allow update, delete: if isAdmin() || isStoreOwner(storeId);
      }

      match /production/{productionId} {
         allow read: if isAdmin() || isStoreOwner(storeId);
         allow create: if isAdmin() || request.auth.uid == request.resource.data.userId;
         allow update, delete: if isAdmin() || isStoreOwner(storeId);
      }

      match /transactions/{transactionId} {
        allow read, write: if isAdmin() || isStoreOwner(storeId);

        match /soldItems/{soldItemId} {
           allow read, write: if isAdmin() || isStoreOwner(storeId);
        }
      }

      match /daily_transactions/{dailyTxId} {
        allow read, write: if isAdmin() || isStoreOwner(storeId);
      }

      match /product_boxes/{categoryId} {
        allow read: if request.auth != null;
        allow write: if isAdmin() || isStoreOwner(storeId);
      }

      match /daily_wastes/{dailyWasteId} {
        allow read, write: if isAdmin() || isStoreOwner(storeId);
      }

      match /pos_backup_metadata/{backupId} {
        allow read, write: if isAdmin() || isStoreOwner(storeId);
      }
    }

    match /ai_analyses/{analysisId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow delete: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
    }
  }
}
