
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) && get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.role == 'admin';
    }

    match /roles_admin/{uid} {
      allow get: if isAdmin() || request.auth.uid == uid;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    match /stores/{storeId} {
      allow read: if isAdmin() || resource.data.userId == request.auth.uid;
      allow write: if isAdmin();

      match /products/{productId} {
        allow read, write: if isAdmin() || get(/databases/$(database)/documents/stores/$(storeId)).data.userId == request.auth.uid;
      }
      
      match /waste/{wasteId} {
         allow read: if isAdmin() || get(/databases/$(database)/documents/stores/$(storeId)).data.userId == request.auth.uid;
         allow create: if request.auth.uid == request.resource.data.userId;
         allow update, delete: if isAdmin() || get(/databases/$(database)/documents/stores/$(storeId)).data.userId == request.auth.uid;
      }
    }
  }
}
