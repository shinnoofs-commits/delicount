
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Use get() which returns null for non-existent doc, vs exists() which returns bool
      // This prevents errors on non-existent documents.
      return get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) != null &&
             get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.role == 'admin';
    }

    function isStoreMember(storeId) {
      return exists(/databases/$(database)/documents/stores/$(storeId)/staff/$(request.auth.uid));
    }

    match /roles_admin/{uid} {
      allow create: if request.auth.uid == uid;
      allow read: if request.auth.uid == uid;
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /stores/{storeId} {
      allow write: if isAdmin();
      allow read: if isAdmin();

      // Rules for products subcollection
      match /products/{productId} {
        // Admins can manage products. Store members can view them.
        allow read: if isAdmin() || isStoreMember(storeId);
        allow write: if isAdmin();
      }
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
