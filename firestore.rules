
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Check if user is authenticated
      if (request.auth == null) {
        return false;
      }
      // Safely get the user's role document
      let userRoleDoc = get(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      // Check for document existence and the role property
      return userRoleDoc != null && 'role' in userRoleDoc.data && userRoleDoc.data.role == 'admin';
    }

    function isStoreMember(storeId) {
      return exists(/databases/$(database)/documents/stores/$(storeId)/staff/$(request.auth.uid));
    }

    match /roles_admin/{uid} {
      allow create: if request.auth.uid == uid;
      allow read: if request.auth.uid == uid;
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /stores/{storeId} {
      allow write: if isAdmin();
      allow read: if isAdmin();

      // Rules for products subcollection
      match /products/{productId} {
        // Admins can manage products. Store members can view them.
        allow read: if isAdmin() || isStoreMember(storeId);
        allow write: if isAdmin();
      }

      // Rules for staff subcollection
      match /staff/{staffId} {
        allow read: if isAdmin() || isStoreMember(storeId);
        allow write: if isAdmin();
      }
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
