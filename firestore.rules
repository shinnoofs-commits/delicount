/**
 * @fileoverview Firestore Security Rules for a Point-of-Sale (POS) application.
 *
 * @description
 * This ruleset implements a role-based access control (RBAC) model tailored for a
 * multi-store retail environment. It defines two primary roles: global "Admins"
 * and store-specific "Store Members".
 *
 * @philosophy Core Philosophy
 * The security model is built on the principle of least privilege. Access is
 * granted based on a user's role and their association with a specific store.
 * - Admins: Have unrestricted read/write access to all data across all stores,
 *   granting them full administrative and reporting capabilities.
 * - Store Members (Staff): Have their access strictly confined to the data
 *   within their assigned store's data tree. They can view store products and
 *   staff, and create new transactions, but cannot modify core store data or
 *   access information from other stores.
 *
 * @structure Data Structure
 * Data is hierarchically organized to enforce security boundaries. All operational
 * data (staff, products, transactions) is nested within a top-level `/stores/{storeId}`
 * collection. This segregation by store ID is fundamental to the security model.
 * A separate top-level collection, `/roles_admin`, serves as a simple lookup table
 * to identify users with global admin privileges.
 *
 * @decisions Key Security Decisions
 * - Admin Role Management: The `/roles_admin` collection is intentionally made
 *   read-only for all clients. Admin roles must be granted out-of-band by a
 *   trusted backend process to prevent privilege escalation.
 * - Store Membership Verification: A user is considered a member of a store if a
 *   document with their UID exists in the `/stores/{storeId}/staff` subcollection.
 *   This check is performed using a `get()` call within the rules, which is
 *   an efficient way to verify cross-document relationships.
 * - Write Restrictions: To maintain data integrity, most write operations (especially
 *   on critical data like products and staff lists) are restricted to Admins.
 *   Store Members are only permitted to create new transactions within their own store.
 * - Denormalization for Authorization: The data model denormalizes the `storeId`
 *   and `staffId` onto transaction documents. This avoids costly lookups and
 *   allows for simple, performant rules that can verify path consistency and
 *   creator ownership directly from the document data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    // --------------------------------

    /**
     * @description Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user has global admin privileges.
     * Admin status is granted if a document with the user's UID exists in the
     * `/roles_admin` collection.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the authenticated user is a staff member of a specific store.
     * Membership is confirmed by the existence of a document with the user's UID in the
     * store's `staff` subcollection.
     */
    function isStoreMember(storeId) {
      return isSignedIn() && exists(/databases/$(database)/documents/stores/$(storeId)/staff/$(request.auth.uid));
    }


    // Collection Rules
    // --------------------------------

    /**
     * @description Admin role lookup table. Existence of a document grants admin rights.
     * This collection is read-only from the client to prevent privilege escalation.
     * Admin roles should be managed by a trusted backend service.
     * @path /roles_admin/{uid}
     * @allow (get) Admin user checks their own role via a backend function (denied on client).
     * @deny (create) Any client attempts to grant themselves admin rights.
     * @principle Prevents client-side privilege escalation.
     */
    match /roles_admin/{uid} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Defines a store. Only Admins can create, manage, or view stores.
     * @path /stores/{storeId}
     * @allow (create) An admin creates a new store location.
     * @deny (list) A regular store employee tries to list all stores in the company.
     * @principle Enforces global administrative control over core business entities.
     */
    match /stores/{storeId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Staff members belonging to a specific store.
     * Admins can manage all staff. Store members can view staff in their own store
     * and read their own staff document.
     * @path /stores/{storeId}/staff/{staffId}
     * @allow (list) A store member views the list of colleagues in their store.
     * @deny (update) A store member tries to change their own role to 'Admin'.
     * @principle Scopes data visibility to a user's store and restricts modifications to admins.
     */
    match /stores/{storeId}/staff/{staffId} {
      allow get: if isAdmin() || isStoreMember(storeId);
      allow list: if isAdmin() || isStoreMember(storeId);
      allow create: if isAdmin() && request.resource.data.storeId == storeId;
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Products available at a specific store.
     * Admins have full control. Store members can read product data for their store
     * to perform sales and inventory checks.
     * @path /stores/{storeId}/products/{productId}
     * @allow (list) A store member lists all products to check stock levels.
     * @deny (create) A store member tries to add a new product.
     * @principle Provides read-only access to operational data for non-admin staff.
     */
    match /stores/{storeId}/products/{productId} {
      allow get: if isAdmin() || isStoreMember(storeId);
      allow list: if isAdmin() || isStoreMember(storeId);
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Sales transactions recorded for a specific store.
     * Store members can create transactions for their store, and all members of that
     * store can view them. Admins have full management access.
     * @path /stores/{storeId}/transactions/{transactionId}
     * @allow (create) A staff member creates a new transaction for a sale they just made.
     * @deny (create) A staff member from store 'A' tries to create a transaction for store 'B'.
     * @principle Enforces creator ownership and path consistency for new data.
     */
    match /stores/{storeId}/transactions/{transactionId} {
      allow get: if isAdmin() || isStoreMember(storeId);
      allow list: if isAdmin() || isStoreMember(storeId);
      allow create: if isStoreMember(storeId)
                   && request.resource.data.storeId == storeId
                   && request.resource.data.staffId == request.auth.uid;
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Individual items sold as part of a transaction.
     * Permissions are inherited from the parent transaction. Store members can create
     * these items, while Admins have full control.
     * @path /stores/{storeId}/transactions/{transactionId}/soldItems/{soldItemId}
     * @allow (list) A store member views the items sold in a specific transaction.
     * @deny (delete) A store member tries to remove an item from a completed transaction.
     * @principle Secures child documents based on the access rules of their parent.
     */
    match /stores/{storeId}/transactions/{transactionId}/soldItems/{soldItemId} {
      allow get: if isAdmin() || isStoreMember(storeId);
      allow list: if isAdmin() || isStoreMember(storeId);
      allow create: if isStoreMember(storeId) && request.resource.data.transactionId == transactionId;
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
  }
}