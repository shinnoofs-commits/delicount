
{
  "entities": {
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "description": "Represents a product in the retail store.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the product."
        },
        "name": {
          "type": "string",
          "description": "Name of the product."
        },
        "price": {
          "type": "number",
          "description": "Price of the product."
        },
        "stock": {
          "type": "number",
          "description": "Current stock level of the product."
        },
        "sku": {
          "type": "string",
          "description": "Stock Keeping Unit code for the product."
        },
        "category": {
          "type": "string",
          "description": "Category of the product."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the product image.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "name",
        "price",
        "stock",
        "sku",
        "category",
        "imageUrl"
      ]
    },
    "Transaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Transaction",
      "type": "object",
      "description": "Represents a sales transaction.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the transaction."
        },
        "dateTime": {
          "type": "string",
          "description": "Date and time of the transaction.",
          "format": "date-time"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment method used for the transaction."
        },
        "totalAmount": {
          "type": "number",
          "description": "Total amount of the transaction."
        },
        "discountAmount": {
          "type": "number",
          "description": "Discount amount applied to the transaction."
        },
        "couponCode": {
          "type": "string",
          "description": "Coupon code applied to the transaction, if any."
        },
        "soldItems": {
          "type": "array",
          "description": "List of items sold in the transaction.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "dateTime",
        "paymentMethod",
        "totalAmount",
        "soldItems"
      ]
    },
    "SoldItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SoldItem",
      "type": "object",
      "description": "Represents an item sold within a transaction.  This is an associative entity to capture quantity and price at the time of sale.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the sold item record."
        },
        "transactionId": {
          "type": "string",
          "description": "Reference to Transaction. (Relationship: Transaction 1:N SoldItem)"
        },
        "productId": {
          "type": "string",
          "description": "Reference to Product. (Relationship: Product 1:N SoldItem)"
        },
        "quantity": {
          "type": "number",
          "description": "Quantity of the product sold."
        },
        "unitPrice": {
          "type": "number",
          "description": "Unit price of the product at the time of sale."
        }
      },
      "required": [
        "id",
        "transactionId",
        "productId",
        "quantity",
        "unitPrice"
      ]
    },
    "Store": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Store",
      "type": "object",
      "description": "Represents a store location with its own login credentials.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the store."
        },
        "name": {
          "type": "string",
          "description": "Name of the store."
        },
        "email": {
          "type": "string",
          "description": "Login email for the store.",
          "format": "email"
        },
        "userId": {
          "type": "string",
          "description": "The Firebase Auth UID for this store's login."
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "userId"
      ]
    },
    "AdminRole": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AdminRole",
      "type": "object",
      "description": "Represents an admin role document.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the admin user."
        },
        "email": {
          "type": "string",
          "description": "Email of the admin user.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "Should be 'admin'.",
          "enum": [
            "admin"
          ]
        }
      },
      "required": [
        "name",
        "role",
        "email"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "stores/{storeId}",
        "definition": {
          "entityName": "Store",
          "schema": {
            "$ref": "#/backend/entities/Store"
          },
          "description": "Stores collection to hold store-specific data.",
          "params": [
            {
              "name": "storeId",
              "description": "Unique identifier for the store."
            }
          ]
        }
      },
      {
        "path": "stores/{storeId}/products/{productId}",
        "definition": {
          "entityName": "Product",
          "schema": {
            "$ref": "#/backend/entities/Product"
          },
          "description": "Products subcollection under each store.",
          "params": [
            {
              "name": "storeId",
              "description": "Unique identifier for the store."
            },
            {
              "name": "productId",
              "description": "Unique identifier for the product."
            }
          ]
        }
      },
      {
        "path": "stores/{storeId}/transactions/{transactionId}",
        "definition": {
          "entityName": "Transaction",
          "schema": {
            "$ref": "#/backend/entities/Transaction"
          },
          "description": "Transactions subcollection under each store. Includes denormalized 'storeId' for authorization independence.",
          "params": [
            {
              "name": "storeId",
              "description": "Unique identifier for the store."
            },
            {
              "name": "transactionId",
              "description": "Unique identifier for the transaction."
            }
          ]
        }
      },
      {
        "path": "stores/{storeId}/transactions/{transactionId}/soldItems/{soldItemId}",
        "definition": {
          "entityName": "SoldItem",
          "schema": {
            "$ref": "#/backend/entities/SoldItem"
          },
          "description": "Sold Items subcollection under each Transaction.",
          "params": [
            {
              "name": "storeId",
              "description": "Unique identifier for the store."
            },
            {
              "name": "transactionId",
              "description": "Unique identifier for the transaction."
            },
            {
              "name": "soldItemId",
              "description": "Unique identifier for the sold item."
            }
          ]
        }
      },
      {
        "path": "roles_admin/{uid}",
        "definition": {
          "entityName": "admin_role",
          "schema": {
            "$ref": "#/backend/entities/AdminRole"
          },
          "description": "Admin roles collection, existence of a document grants admin privileges.",
          "params": [
            {
              "name": "uid",
              "description": "User ID for the admin."
            }
          ]
        }
      }
    ],
    "reasoning": "The Firestore structure is designed to support the SwiftPOS application's requirements for product management, sales tracking, user/permission management, and reporting. The core principle is Authorization Independence, achieved through denormalization where necessary. The structure leverages path-based ownership and membership maps to simplify security rules and enable QAPs. Specifically, the `stores/{storeId}` collection holds store-specific data. Products are located at `stores/{storeId}/products/{productId}` to associate them with a store. Transactions are located at `stores/{storeId}/transactions/{transactionId}`. The `storeId` is denormalized into the transaction. The main collections and subcollections are used to maintain data segregation by store. This design enables straightforward security rules that prevent unauthorized access to data. Finally, to easily show a dashboard with all the transactions, the `transactions` collection will also contain the storeId so that the dashboard can filter by store ID, and global admins will have access to all transactions. To support listing products and transactions securely (QAPs), each collection is scoped to a store. This structure allows us to write security rules that check the user's role and grant access accordingly, ensuring that only authorized users can access the data."
  }
}
