
{
  "entities": {
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "description": "Represents a product in the retail store.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the product."
        },
        "name": {
          "type": "string",
          "description": "Name of the product."
        },
        "price": {
          "type": "number",
          "description": "Price of the product."
        },
        "costPrice": {
          "type": "number",
          "description": "Cost price of the product."
        },
        "productCode": {
          "type": "string",
          "description": "Product code."
        },
        "category": {
          "type": "string",
          "description": "Category of the product."
        },
        "pricePattern": {
          "type": "string"
        },
        "dailyProductionSunny": {
          "$ref": "#/backend/entities/DailyProduction"
        },
        "dailyProductionRainy": {
          "$ref": "#/backend/entities/DailyProduction"
        }
      },
      "required": [
        "id",
        "name",
        "price",
        "costPrice",
        "productCode",
        "category"
      ]
    },
    "DailyProduction": {
      "type": "object",
      "properties": {
        "sun": { "type": "number" },
        "mon": { "type": "number" },
        "tue": { "type": "number" },
        "wed": { "type": "number" },
        "thu": { "type": "number" },
        "fri": { "type": "number" },
        "sat": { "type": "number" },
        "holiday": { "type": "number" }
      }
    },
    "Transaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Transaction",
      "type": "object",
      "description": "Represents a sales transaction.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the transaction."
        },
        "dateTime": {
          "type": "string",
          "description": "Date and time of the transaction.",
          "format": "date-time"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment method used for the transaction."
        },
        "totalAmount": {
          "type": "number",
          "description": "Total amount of the transaction."
        },
        "discountAmount": {
          "type": "number",
          "description": "Discount amount applied to the transaction."
        },
        "couponCode": {
          "type": "string",
          "description": "Coupon code applied to the transaction, if any."
        },
        "soldItems": {
          "type": "array",
          "description": "List of items sold in the transaction.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "dateTime",
        "paymentMethod",
        "totalAmount",
        "soldItems"
      ]
    },
    "SoldItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SoldItem",
      "type": "object",
      "description": "Represents an item sold within a transaction.  This is an associative entity to capture quantity and price at the time of sale.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the sold item record."
        },
        "transactionId": {
          "type": "string",
          "description": "Reference to Transaction. (Relationship: Transaction 1:N SoldItem)"
        },
        "productId": {
          "type": "string",
          "description": "Reference to Product. (Relationship: Product 1:N SoldItem)"
        },
        "quantity": {
          "type": "number",
          "description": "Quantity of the product sold."
        },
        "unitPrice": {
          "type": "number",
          "description": "Unit price of the product at the time of sale."
        }
      },
      "required": [
        "id",
        "transactionId",
        "productId",
        "quantity",
        "unitPrice"
      ]
    },
    "Store": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Store",
      "type": "object",
      "description": "Represents a store location with its own login credentials.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the store."
        },
        "name": {
          "type": "string",
          "description": "Name of the store."
        },
        "email": {
          "type": "string",
          "description": "Login email for the store.",
          "format": "email"
        },
        "userId": {
          "type": "string",
          "description": "The Firebase Auth UID for this store's login."
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "userId"
      ]
    },
    "AdminRole": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AdminRole",
      "type": "object",
      "description": "Represents an admin role document.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the admin user."
        },
        "email": {
          "type": "string",
          "description": "Email of the admin user.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "Should be 'admin'.",
          "enum": [
            "admin"
          ]
        }
      },
      "required": [
        "name",
        "role",
        "email"
      ]
    },
    "ProductionEntry": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ProductionEntry",
      "type": "object",
      "description": "Represents a record of products produced on a given day.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the production entry."
        },
        "storeId": {
          "type": "string",
          "description": "ID of the store where production was recorded."
        },
        "userId": {
          "type": "string",
          "description": "ID of the user who recorded the production."
        },
        "date": {
          "type": "string",
          "description": "Date of production.",
          "format": "date-time"
        },
        "totalProductionCount": {
          "type": "number",
          "description": "Total number of items produced in this entry."
        },
        "items": {
          "type": "array",
          "description": "List of items produced.",
          "items": {
            "type": "object",
            "properties": {
              "productId": {
                "type": "string"
              },
              "productCode": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              }
            },
            "required": [
              "productId",
              "name",
              "quantity"
            ]
          }
        }
      },
      "required": [
        "id",
        "storeId",
        "userId",
        "date",
        "items",
        "totalProductionCount"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "stores/{storeId}",
        "definition": {
          "entityName": "Store",
          "schema": {
            "$ref": "#/backend/entities/Store"
          },
          "description": "Stores collection to hold store-specific data.",
          "params": [
            {
              "name": "storeId",
              "description": "Unique identifier for the store."
            }
          ]
        }
      },
      {
        "path": "stores/{storeId}/products/{productId}",
        "definition": {
          "entityName": "Product",
          "schema": {
            "$ref": "#/backend/entities/Product"
          },
          "description": "Products subcollection under each store.",
          "params": [
            {
              "name": "storeId",
              "description": "Unique identifier for the store."
            },
            {
              "name": "productId",
              "description": "Unique identifier for the product."
            }
          ]
        }
      },
      {
        "path": "stores/{storeId}/transactions/{transactionId}",
        "definition": {
          "entityName": "Transaction",
          "schema": {
            "$ref": "#/backend/entities/Transaction"
          },
          "description": "Transactions subcollection under each store.",
          "params": [
            {
              "name": "storeId",
              "description": "Unique identifier for the store."
            },
            {
              "name": "transactionId",
              "description": "Unique identifier for the transaction."
            }
          ]
        }
      },
      {
        "path": "stores/{storeId}/production/{productionId}",
        "definition": {
          "entityName": "ProductionEntry",
          "schema": {
            "$ref": "#/backend/entities/ProductionEntry"
          },
          "description": "Production subcollection.",
          "params": [
            {
              "name": "storeId",
              "description": "Store ID."
            },
            {
              "name": "productionId",
              "description": "Production entry ID."
            }
          ]
        }
      },
      {
        "path": "roles_admin/{uid}",
        "definition": {
          "entityName": "AdminRole",
          "schema": {
            "$ref": "#/backend/entities/AdminRole"
          },
          "description": "Admin roles.",
          "params": [
            {
              "name": "uid",
              "description": "User UID."
            }
          ]
        }
      }
    ]
  }
}
